    <!-- 4. Luminous Electric Cyan Crescent Core -->
    <path android:pathData="M55.3,35.0 A19.1,19.1 0 1,1 55.3,73.2 A19.1,19.1 0 1,1 55.3,35.0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="46"
                android:startY="36"
                android:endX="74"
                android:endY="68">
                <item android:offset="0.0" android:color="#64FAFF" />
                <item android:offset="0.45" android:color="#9EFFFF" />
                <item android:offset="0.75" android:color="#00F5FF" />
                <item android:offset="1.0" android:color="#00D4F0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 5. Inner Matte Black Eclipse Disc (Occluder) -->
    <path android:pathData="M52.3,36.3 A17.6,17.6 0 1,1 52.3,71.5 A17.6,17.6 0 1,1 52.3,36.3 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="36"
                android:startY="38"
                android:endX="68"
                android:endY="70">
                <item android:offset="0.0" android:color="#0D1116" />
                <item android:offset="0.45" android:color="#06080B" />
                <item android:offset="1.0" android:color="#020305" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 6. Precision 3D rim highlight along the dark disc edge -->
    <path
        android:pathData="M52.3,36.3 A17.6,17.6 0 1,1 52.3,71.5 A17.6,17.6 0 1,1 52.3,36.3 Z"
        android:strokeWidth="0.45">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="34.7"
                android:startY="53.9"
                android:endX="69.9"
                android:endY="53.9">
                <item android:offset="0.0" android:color="#403A5A66" />
                <item android:offset="0.65" android:color="#2500B8D4" />
                <item android:offset="1.0" android:color="#9052FFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
